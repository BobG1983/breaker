// Smoke test for Drift hazard at stack 3.
//
// Verifies that activating 3 Drift stacks via InjectHazardStack does not panic
// and that core invariants (NoNaN, BoltInBounds, HazardStackValid) hold.
// Physics is intentionally disabled (disable_physics: true) to keep this as a
// lightweight activation test. End-to-end force pipeline coverage is in
// scenarios/hazards/drift_hazard_chaos.scenario.ron.
(
    breaker: "Aegis",
    layout: "Corridor",
    input: Scripted((
        actions: [],
    )),
    max_frames: 500,
    disallowed_failures: [
        NoNaN,
        BoltInBounds,
        BreakerInBounds,
        TimerNonNegative,
        HazardStackValid,
    ],
    allowed_failures: None,
    debug_setup: (
        disable_physics: true,
    ),
    frame_mutations: [
        (frame: 10, mutation: InjectHazardStack(kind_name: "Drift", stacks: 3)),
    ],
)
