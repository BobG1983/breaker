// Smoke test for RecklessDash protocol scaffold.
//
// Activates the protocol via InjectProtocol at frame 10. The protocol is
// currently a config-insertion + info-stub scaffold; this scenario
// validates that the dispatch path runs without panicking and that no
// invariants regress from the inserted config resource. When runtime
// behaviour lands, this scenario will start exercising it without spec
// changes.
(
    breaker: "Aegis",
    layout: "Corridor",
    input: Scripted((
        actions: [],
    )),
    max_frames: 500,
    disallowed_failures: [
        NoNaN,
        BoltInBounds,
        BreakerInBounds,
        TimerNonNegative,
        BoltSpeedAccurate,
    ],
    allowed_failures: None,
    debug_setup: (
        disable_physics: true,
    ),
    frame_mutations: [
        (frame: 10, mutation: InjectProtocol(kind_name: "RecklessDash")),
    ],
)
