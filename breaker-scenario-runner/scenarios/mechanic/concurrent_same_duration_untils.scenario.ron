// Adversarial: two Until(TimeExpires(3.0)) entries on the same bolt from different sources.
// Overclock chip installs Under source "chip:Overclock:Common"; Kickstart protocol under "protocol:Kickstart".
// Regression target: on_time_expires source-filter at effect_v3/triggers/time/bridges/system.rs:36-49.
// If the source filter is broken, one timer's expiry walks both Until entries — BoltSpeedAccurate catches
// the resulting double-reversal or cross-contamination that corrupts speed state.
(
    breaker: "Aegis",
    layout: "Dense",
    input: Perfect(AlwaysPerfect),
    max_frames: 5000,
    disallowed_failures: [BoltInBounds, BoltSpeedAccurate, BreakerInBounds, BreakerCountReasonable, NoEntityLeaks, NoNaN],
    allowed_failures: None,
    debug_setup: None,
    allow_early_end: true,
    seed: 1,
    chip_selections: ["Overclock"],
    frame_mutations: [
        (frame: 10, mutation: InjectProtocol(kind_name: "Kickstart")),
    ],
)
