// Self-test: FissionCounterOrphaned CONTRACT invariant fires when FissionCounter.kills > 0
// but Fission is not in ActiveProtocols.
//
// Sequence:
//   frame 10 — InjectProtocol installs Fission in ActiveProtocols and inserts FissionConfig.
//   frame 30 — SetFissionCounter seeds kills=7 (bypasses normal cell-kill accumulation).
//   frame 50 — RemoveFromActiveProtocols removes Fission without clearing FissionCounter.
//   frame 51+ — check_fission_counter_orphaned sees kills=7 with Fission absent → VIOLATION.
//
// Physics disabled so no cells are destroyed and the counter never increments during
// the test window. The invariant fires on every frame from 51 to max_frames.
(
    breaker: "Aegis",
    layout: "Corridor",
    input: Scripted((
        actions: [],
    )),
    max_frames: 120,
    disallowed_failures: [FissionCounterOrphaned],
    allowed_failures: Some([FissionCounterOrphaned]),
    debug_setup: (
        disable_physics: true,
        node_timer_remaining: 9999.0,
    ),
    frame_mutations: [
        (frame: 10, mutation: InjectProtocol(kind_name: "Fission")),
        (frame: 30, mutation: SetFissionCounter(kills: 7)),
        (frame: 50, mutation: RemoveFromActiveProtocols(kind_name: "Fission")),
    ],
)
