                        plant_delay: 0.3,
                    ))),
                ),
            ),
            Stamp(EveryBolt,
                Until(NodeEndOccurred,
                    Fire(Piercing(PiercingConfig(charges: 1))),
                ),
            ),
        ],
    ),
)
