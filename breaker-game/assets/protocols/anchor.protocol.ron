(
    name: "Anchor",
    description: "Stand still to plant. While planted: stronger bumps, wider perfect window.",
    unlock_tier: 0,
    tuning: Anchor(
        effects: [
            Stamp(Breaker,
                Until(NodeEndOccurred,
                    Fire(Anchor(AnchorConfig(
                        bump_force_multiplier: 2.0,
